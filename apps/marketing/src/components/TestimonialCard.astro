---
export interface Props {
  quote: string;
  name: string;
  role: string;
  avatar?: string;
}
const { quote, name, role, avatar } = Astro.props;
---

<div class="bg-white rounded-2xl border border-dove p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-6">
  <!-- Quote mark -->
  <svg class="w-8 h-8 text-sand flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
  </svg>
  <p class="text-base text-deep-taupe leading-relaxed flex-1 italic">"{quote}"</p>
  <div class="flex items-center gap-3">
    {avatar ? (
      <img src={avatar} alt={name} class="w-10 h-10 rounded-full object-cover" />
    ) : (
      <div class="w-10 h-10 rounded-full bg-dove flex items-center justify-center text-warm-brown font-bold text-sm">
        {name[0]}
      </div>
    )}
    <div>
      <p class="text-sm font-semibold text-deep-taupe">{name}</p>
      <p class="text-xs text-stone">{role}</p>
    </div>
  </div>
</div>
