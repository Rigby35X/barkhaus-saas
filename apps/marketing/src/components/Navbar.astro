---
export interface Props { currentPage?: string }
const { currentPage = '' } = Astro.props;
const links = [
  { href: '/features', label: 'Platform' },
  { href: '/features/animals', label: 'Animal records' },
  { href: '/features/public-website', label: 'Website builder' },
  { href: '/features/applications', label: 'Applications' },
  { href: '/features/social-media', label: 'Marketing tools' },
  { href: '/about', label: 'Our story' },
];
---
<header class="bh-nav" id="site-nav">
  <div class="bh-container bh-nav-inner">
    <a class="bh-logo" href="/" aria-label="BarkHaus home"><img src="/logo-dark.png" alt="" width="42" height="42" /><span>BarkHaus</span></a>
    <nav class="bh-nav-links" aria-label="Main navigation">
      {links.map(link => <a href={link.href} aria-current={currentPage === link.href ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="bh-nav-actions"><a class="bh-nav-login" href="/login">Log in</a><a class="bh-nav-cta" href="/contact">Talk to us <span aria-hidden="true">↗</span></a></div>
    <button class="bh-menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-navigation"><span></span><span></span><span></span></button>
  </div>
  <nav class="bh-mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" hidden>
    {links.map(link => <a href={link.href}>{link.label}</a>)}
    <a href="/contact">Contact</a><a href="/login">Log in</a>
  </nav>
</header>
<script>
  const nav = document.getElementById('site-nav')!;
  const button = nav.querySelector<HTMLButtonElement>('.bh-menu-button')!;
  const mobile = document.getElementById('mobile-navigation')!;
  const close = () => { mobile.hidden = true; button.setAttribute('aria-expanded', 'false'); button.setAttribute('aria-label', 'Open menu'); };
  button.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    mobile.hidden = !open; button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  window.addEventListener('keydown', event => { if (event.key === 'Escape') close(); });
  window.addEventListener('resize', () => { if (window.innerWidth > 1000) close(); });
</script>
<style>
  .bh-nav{position:fixed;top:0;left:0;right:0;z-index:60;background:#28211e;color:#fff;border-bottom:1px solid #51433a}
  .bh-nav-inner{min-height:72px;display:flex;align-items:center;gap:28px}.bh-logo{flex-shrink:0;display:flex;align-items:center;gap:8px;color:white;text-decoration:none;font-family:'Noto Serif',Georgia,serif;font-size:1.22rem;letter-spacing:-.03em}.bh-logo img{width:40px;height:40px;object-fit:contain}.bh-nav-links{display:flex;gap:24px;margin-left:auto;align-items:center}.bh-nav-links a,.bh-nav-login{font-size:.76rem;color:#f7f1ec;text-decoration:none;white-space:nowrap}.bh-nav-links a:hover,.bh-nav-login:hover,.bh-nav-links a[aria-current=page]{color:#dbb69d}.bh-nav-actions{display:flex;align-items:center;gap:20px}.bh-nav-cta{background:#a66b52;color:#fff;padding:12px 18px;text-decoration:none;border-radius:3px;font-size:.76rem;font-weight:600;white-space:nowrap}.bh-nav-cta span{margin-left:13px}.bh-nav-cta:hover{background:#87513d}.bh-menu-button{display:none;border:0;background:transparent;color:white;padding:12px;margin-left:auto;cursor:pointer}.bh-menu-button span{display:block;width:22px;height:2px;background:currentColor;margin:5px 0}.bh-mobile-nav{background:#28211e;padding:12px 24px 28px;border-top:1px solid #51433a;max-height:calc(100vh - 72px);overflow-y:auto}.bh-mobile-nav[hidden]{display:none}.bh-mobile-nav a{display:block;color:white;text-decoration:none;padding:13px 2px;border-bottom:1px solid #51433a;font-size:.9rem}
  @media(max-width:1000px){.bh-nav-links,.bh-nav-actions{display:none}.bh-menu-button{display:block}}
</style>
