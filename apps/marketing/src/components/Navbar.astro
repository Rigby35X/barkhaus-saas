---
export interface Props { currentPage?: string; }
const { currentPage = '' } = Astro.props;
const isActive = (href: string) => currentPage === href || currentPage.startsWith(href + '/');

const productLinks = [
  { href: '/features/animals', label: 'Animal Management', description: 'Manage every animal from intake through outcome.' },
  { href: '/features/applications', label: 'Applications', description: 'Keep adoption and foster applications organized.' },
  { href: '/features/public-website', label: 'Rescue Websites', description: 'A beautiful site connected to your rescue data.' },
  { href: '/features/integrations', label: 'Integrations & Imports', description: 'Bring your current tools and data with you.' },
];

const companyLinks = [
  { href: '/about', label: 'About BarkHaus' },
  { href: '/blog', label: 'Resources' },
  { href: '/contact', label: 'Contact' },
];
---

<nav id="navbar" class="scheme-8 fixed top-0 left-0 right-0 z-50 border-b border-white/10 transition-shadow duration-300" data-navbar>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center shrink-0" aria-label="BarkHaus home">
        <img src="/logo-dark.png" alt="BarkHaus" class="h-9 w-auto" />
      </a>

      <div class="hidden lg:flex items-center gap-1">
        <div class="relative group">
          <button class={`px-3 py-2 text-sm font-medium rounded-button transition-colors flex items-center gap-1 ${isActive('/features') ? 'text-white' : 'text-white/80 hover:text-white'}`}>
            Product
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[520px]">
            <div class="scheme-7 rounded-card border scheme-border shadow-2xl p-4">
              <a href="/features" class="block rounded-button px-3 py-2 mb-2 font-semibold hover:bg-cararra-3">Explore all features</a>
              <div class="grid grid-cols-2 gap-2">
                {productLinks.map((item) => (
                  <a href={item.href} class="block rounded-button p-3 hover:bg-cararra-3 transition-colors">
                    <span class="block text-sm font-semibold mb-1">{item.label}</span>
                    <span class="block text-xs opacity-70 leading-relaxed">{item.description}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <a href="/#start-your-way" class="px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-button transition-colors">How It Fits</a>
        <a href="/#migration" class="px-3 py-2 text-sm font-medium text-white/80 hover:text-white rounded-button transition-colors">Switching Is Easy</a>
        <a href="/about" class={`px-3 py-2 text-sm font-medium rounded-button transition-colors ${isActive('/about') ? 'text-white' : 'text-white/80 hover:text-white'}`}>About</a>
        <a href="/contact" class={`px-3 py-2 text-sm font-medium rounded-button transition-colors ${isActive('/contact') ? 'text-white' : 'text-white/80 hover:text-white'}`}>Contact</a>
      </div>

      <div class="hidden lg:flex items-center gap-3">
        <a href="/login" class="px-4 py-2 text-sm font-semibold text-white border border-white/30 rounded-button hover:border-white hover:bg-white/5 transition">Log In</a>
        <a href="/waitlist" class="px-4 py-2 text-sm font-semibold bg-warm-brown text-white rounded-button hover:opacity-90 transition">Join Early Access</a>
      </div>

      <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-button text-white hover:bg-white/10 transition" aria-label="Open menu" aria-expanded="false">
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden scheme-8 border-t border-white/10 max-h-[calc(100vh-4rem)] overflow-y-auto">
    <div class="px-4 py-4 space-y-1">
      <a href="/features" class="block px-3 py-2 rounded-button text-sm font-semibold text-white">Product</a>
      {productLinks.map((item) => <a href={item.href} class="block px-6 py-2 rounded-button text-sm text-white/75 hover:text-white">{item.label}</a>)}
      <a href="/#start-your-way" class="block px-3 py-2 rounded-button text-sm font-medium text-white/80 hover:text-white">How It Fits</a>
      <a href="/#migration" class="block px-3 py-2 rounded-button text-sm font-medium text-white/80 hover:text-white">Switching Is Easy</a>
      {companyLinks.map((item) => <a href={item.href} class="block px-3 py-2 rounded-button text-sm font-medium text-white/80 hover:text-white">{item.label}</a>)}
      <a href="/login" class="block mt-3 px-3 py-2 rounded-button text-sm font-semibold text-white border border-white/30 text-center">Log In</a>
      <a href="/waitlist" class="block mt-2 px-3 py-2 rounded-button text-sm font-semibold bg-warm-brown text-white text-center">Join Early Access</a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.querySelector('[data-navbar]') as HTMLElement;
  const updateNavbar = () => navbar?.classList.toggle('shadow-lg', window.scrollY > 40);
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
