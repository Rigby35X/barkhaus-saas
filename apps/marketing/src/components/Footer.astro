const productLinks = [
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/signup', label: 'Sign up' },
  { href: '/login', label: 'Log In' },
];

const companyLinks = [
  { href: '/about', label: 'About Us' },
  { href: '/my-dog-cinco', label: 'My Dog Cinco' },
  { href: '/partners', label: 'Partners' },
  { href: '/careers', label: 'Careers' },
];

const supportLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/waitlist', label: 'Join Waitlist' },
  { href: '/contact', label: 'Contact Us' },
  { href: 'mailto:support@barkhaus.io', label: 'support@barkhaus.io' },
];
---
<footer class="scheme-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div>
        <a href="/" class="inline-block mb-4">
          <img src="/logo-dark.png" alt="Barkhaus" class="h-9 w-auto" />
        </a>
        <p class="text-sm text-white/70 leading-relaxed max-w-xs mb-5">
          The all-in-one platform for animal rescues.
        </p>
        <div class="flex gap-3">
          {socials.map(({ label, href, d }) => (
            <a href={href} aria-label={label} class="w-9 h-9 rounded-full border border-white/20 flex items-center justify-center text-white/70 hover:text-white hover:border-white/50 transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={d} /></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Product -->
      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-white/50 mb-4">Product</h4>
        <ul class="space-y-2">
          {productLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-white/80 hover:text-white transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-white/50 mb-4">Company</h4>
        <ul class="space-y-2">
          {companyLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-white/80 hover:text-white transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-white/50 mb-4">Support</h4>
        <ul class="space-y-2">
          {supportLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-white/80 hover:text-white transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/50">&copy; {new Date().getFullYear()} Barkhaus, Inc. All rights reserved.</p>
      <div class="flex gap-4 text-xs text-white/50">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
