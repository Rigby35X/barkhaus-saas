---
<footer class="bg-deep-taupe text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">

      <!-- Platform -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-deep-taupe mb-4">Platform</h4>
        <ul class="space-y-2">
          <li><a href="/features" class="text-sm text-dove/80 hover:text-white transition-colors">Features</a></li>
          <li><a href="/pricing" class="text-sm text-dove/80 hover:text-white transition-colors">Pricing</a></li>
          <li><a href="/signup" class="text-sm text-dove/80 hover:text-white transition-colors">Start Free Trial</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-deep-taupe mb-4">Resources</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-dove/80 hover:text-white transition-colors">About</a></li>
          <li><a href="/contact" class="text-sm text-dove/80 hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-deep-taupe mb-4">Company</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-dove/80 hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-sm text-dove/80 hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-deep-taupe mb-4">Support</h4>
        <ul class="space-y-2">
          <li><a href="/contact" class="text-sm text-dove/80 hover:text-white transition-colors">Help Center</a></li>
          <li><a href="mailto:support@barkhaus.com" class="text-sm text-dove/80 hover:text-white transition-colors">support@barkhaus.com</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <a href="/"><img src="/images/logos/7.png" alt="Barkhaus" class="h-8 w-auto" /></a>
      <p class="text-xs text-dove/60">&copy; {new Date().getFullYear()} Barkhaus. All rights reserved.</p>
      <div class="flex gap-4 text-xs text-dove/60">
        <a href="#" class="hover:text-white transition-colors">Privacy</a>
        <a href="#" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
