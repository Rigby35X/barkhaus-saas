---
---
<footer class="bg-deep-taupe text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 mb-12">

      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block mb-4">
          <img src="/images/logos/7.png" alt="Barkhaus" class="h-12 w-auto" />
        </a>
        <p class="text-sm text-dove/70 leading-relaxed max-w-xs">
          The all-in-one platform for rescue organizations. Manage animals, applications, your website, and marketing — all from one dashboard.
        </p>
        <div class="flex gap-3 mt-5">
          <a href="/signup" class="px-4 py-2 text-xs font-semibold bg-warm-brown text-white rounded-xl hover:opacity-90 transition">
            Start Free Trial
          </a>
          <a href="/login" class="px-4 py-2 text-xs font-semibold border border-white/20 text-dove/80 rounded-xl hover:border-white/50 hover:text-white transition">
            Log In
          </a>
        </div>
      </div>

      <!-- Platform -->
      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-dove/50 mb-4">Platform</h4>
        <ul class="space-y-2">
          <li><a href="/features" class="text-sm text-dove/80 hover:text-white transition-colors">Features</a></li>
          <li><a href="/pricing" class="text-sm text-dove/80 hover:text-white transition-colors">Pricing</a></li>
          <li><a href="/signup" class="text-sm text-dove/80 hover:text-white transition-colors">Start Free Trial</a></li>
          <li><a href="/login" class="text-sm text-dove/80 hover:text-white transition-colors">Log In</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-dove/50 mb-4">Company</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-dove/80 hover:text-white transition-colors">About Us</a></li>
          <li><a href="/blog" class="text-sm text-dove/80 hover:text-white transition-colors">Blog</a></li>
          <li><a href="/careers" class="text-sm text-dove/80 hover:text-white transition-colors">Careers</a></li>
          <li><a href="/partners" class="text-sm text-dove/80 hover:text-white transition-colors">Partners</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-dove/50 mb-4">Support</h4>
        <ul class="space-y-2">
          <li><a href="/contact" class="text-sm text-dove/80 hover:text-white transition-colors">Contact Us</a></li>
          <li><a href="mailto:support@barkhaus.com" class="text-sm text-dove/80 hover:text-white transition-colors">support@barkhaus.com</a></li>
          <li><a href="/contact" class="text-sm text-dove/80 hover:text-white transition-colors">Help Center</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-dove/50">&copy; {new Date().getFullYear()} Barkhaus. All rights reserved.</p>
      <div class="flex gap-4 text-xs text-dove/50">
        <a href="#" class="hover:text-white transition-colors">Privacy</a>
        <a href="#" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
