---
const productLinks = [
  { href: '/features', label: 'Platform' },
  { href: '/features/animals', label: 'Animal Management' },
  { href: '/features/applications', label: 'Applications' },
  { href: '/features/public-website', label: 'Rescue Websites' },
  { href: '/features/integrations', label: 'Imports & Integrations' },
];

const companyLinks = [
  { href: '/about', label: 'About BarkHaus' },
  { href: '/blog', label: 'Resources' },
  { href: '/contact', label: 'Contact' },
  { href: '/waitlist', label: 'Early Access' },
];

const startLinks = [
  { href: '/#start-your-way', label: 'Keep My Website' },
  { href: '/#start-your-way', label: 'Keep My Current Software' },
  { href: '/#migration', label: 'Move to BarkHaus' },
  { href: '/login', label: 'Log In' },
];
---
<footer class="scheme-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr_1fr_1fr] gap-10 mb-12">
      <div>
        <a href="/" class="inline-block mb-4">
          <img src="/logo-dark.png" alt="BarkHaus" class="h-9 w-auto" />
        </a>
        <p class="text-sm text-white/70 leading-relaxed max-w-sm mb-4">
          Rescue software that meets you where you are — and grows with you when you&rsquo;re ready.
        </p>
        <p class="text-xs text-white/45 leading-relaxed max-w-sm">
          Animals, applications, websites, imports, and eventually the rest of your rescue operation in one connected platform.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-white/50 mb-4">Product</h4>
        <ul class="space-y-2">
          {productLinks.map((item) => <li><a href={item.href} class="text-sm text-white/80 hover:text-white transition-colors">{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-white/50 mb-4">Start Your Way</h4>
        <ul class="space-y-2">
          {startLinks.map((item) => <li><a href={item.href} class="text-sm text-white/80 hover:text-white transition-colors">{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-xs uppercase tracking-wider text-white/50 mb-4">BarkHaus</h4>
        <ul class="space-y-2">
          {companyLinks.map((item) => <li><a href={item.href} class="text-sm text-white/80 hover:text-white transition-colors">{item.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/50">&copy; {new Date().getFullYear()} BarkHaus. All rights reserved.</p>
      <p class="text-xs text-white/40">Built for rescues, not software teams.</p>
    </div>
  </div>
</footer>
