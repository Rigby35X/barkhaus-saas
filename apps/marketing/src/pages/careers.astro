---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';

const values = [
  { icon: '🐾', title: 'Mission First', description: 'We build for the animals. Every feature we ship should help more of them find homes.' },
  { icon: '🚀', title: 'Ship Fast, Learn Faster', description: 'We favor working software over perfect plans. We iterate quickly and listen to our users.' },
  { icon: '🤝', title: 'Rescue-Informed', description: 'Many of us have worked in or with animal rescue organizations. We build what we know is needed.' },
  { icon: '🌎', title: 'Remote-First', description: 'We\'re a distributed team. Great work happens everywhere, not just in an office.' },
];

const openings = [
  {
    title: 'Full-Stack Engineer',
    team: 'Engineering',
    location: 'Remote',
    type: 'Full-time',
    description: 'Help us build the platform that powers animal rescue organizations. Experience with TypeScript, React, and PostgreSQL preferred.',
  },
  {
    title: 'Product Designer',
    team: 'Design',
    location: 'Remote',
    type: 'Full-time',
    description: 'Design experiences that are beautiful, intuitive, and purposeful. You care about craft and about the mission.',
  },
  {
    title: 'Customer Success Manager',
    team: 'Growth',
    location: 'Remote',
    type: 'Full-time',
    description: 'Be the person who helps shelters get the most out of Barkhaus. Animal rescue background is a big plus.',
  },
];
---

<BaseLayout title="Careers" description="Join the Barkhaus team and help connect more animals with loving homes.">
  <Navbar currentPage="/careers" />

  <main class="pt-24">

    <!-- Hero -->
    <div class="bg-cloud py-20 text-center">
      <div class="max-w-3xl mx-auto px-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-warm-brown mb-3">Join the Team</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-deep-taupe mb-6">Work That Matters</h1>
        <p class="text-lg text-stone leading-relaxed">
          We're a small, passionate team building technology for animal rescue organizations.
          Every line of code we write helps a dog or cat find their forever home.
        </p>
      </div>
    </div>

    <!-- Values -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <h2 class="font-serif text-3xl font-bold text-deep-taupe mb-4">How We Work</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {values.map(({ icon, title, description }) => (
            <div class="text-center">
              <div class="text-4xl mb-4">{icon}</div>
              <h3 class="font-serif text-lg font-semibold text-deep-taupe mb-2">{title}</h3>
              <p class="text-sm text-stone leading-relaxed">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Open roles -->
    <section class="py-20 bg-cloud">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <h2 class="font-serif text-3xl font-bold text-deep-taupe mb-4">Open Positions</h2>
          <p class="text-stone">We're hiring across engineering, design, and growth.</p>
        </div>

        <div class="space-y-4">
          {openings.map(({ title, team, location, type, description }) => (
            <div class="bg-white rounded-2xl border border-dove p-6 hover:shadow-md transition-shadow">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <h3 class="font-serif text-xl font-semibold text-deep-taupe mb-1">{title}</h3>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs bg-cloud px-2 py-1 rounded-full text-stone">{team}</span>
                    <span class="text-xs bg-cloud px-2 py-1 rounded-full text-stone">{location}</span>
                    <span class="text-xs bg-cloud px-2 py-1 rounded-full text-stone">{type}</span>
                  </div>
                  <p class="text-sm text-stone">{description}</p>
                </div>
                <a
                  href={`mailto:careers@barkhaus.io?subject=Application: ${title}`}
                  class="flex-shrink-0 px-5 py-2 bg-warm-brown text-white rounded-xl text-sm font-semibold hover:opacity-90 transition"
                >
                  Apply
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center mt-12 bg-white rounded-2xl border border-dove p-8">
          <h3 class="font-serif text-xl font-semibold text-deep-taupe mb-2">Don't See a Fit?</h3>
          <p class="text-stone mb-4">We're always looking for great people. Send us your story.</p>
          <a
            href="mailto:careers@barkhaus.io?subject=General Application"
            class="inline-block px-6 py-2 border border-warm-brown text-warm-brown rounded-xl text-sm font-semibold hover:bg-dove transition"
          >
            Send a Note
          </a>
        </div>
      </div>
    </section>

    <CTABanner
      headline="Let's Build Something That Matters"
      subtext="Join us in giving every rescue the tools they need to save more lives."
      primaryCta={{ label: 'View Open Roles', href: '#' }}
      secondaryCta={{ label: 'Learn About Barkhaus', href: '/about' }}
    />

  </main>

  <Footer />
</BaseLayout>
