---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LoginForm from '../components/LoginForm.tsx';
---

<BaseLayout title="Sign In" description="Sign in to your Barkhaus account.">
  <Navbar currentPage="/login" />

  <main class="min-h-screen bg-cloud pt-24 pb-16 px-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md mx-auto p-8 mt-8">
      <div class="text-center mb-6">
        <a href="/"><img src="/images/logos/6.png" alt="Barkhaus" class="h-10 w-auto mx-auto" /></a>
      </div>
      <LoginForm client:load />
    </div>
  </main>

  <Footer />
</BaseLayout>
