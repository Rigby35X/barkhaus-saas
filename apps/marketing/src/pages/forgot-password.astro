---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Forgot Password" description="Reset your Barkhaus password.">
  <Navbar currentPage="/forgot-password" />

  <main class="min-h-screen bg-cloud pt-24 pb-16 px-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md mx-auto p-8 mt-8">
      <div class="text-center mb-6">
        <a href="/"><img src="/images/logos/6.png" alt="Barkhaus" class="h-10 w-auto mx-auto" /></a>
      </div>

      <div class="text-center mb-8">
        <h2 class="font-serif text-2xl font-bold text-deep-taupe mb-2">Reset Your Password</h2>
        <p class="text-deep-taupe">Enter your email and we'll send you a reset link.</p>
      </div>

      <form id="forgot-form" class="space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold text-deep-taupe uppercase tracking-wider mb-1">Email</label>
          <input
            type="email"
            id="forgot-email"
            name="email"
            placeholder="jane@happypaws.org"
            required
            class="w-full border border-silver-gray rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-warm-brown"
          />
        </div>

        <div id="forgot-success" class="hidden text-sm text-green-700 bg-green-50 rounded-xl px-3 py-2">
          If an account exists with that email, a reset link has been sent.
        </div>
        <div id="forgot-error" class="hidden text-sm text-red-600 bg-red-50 rounded-xl px-3 py-2"></div>

        <button
          type="submit"
          id="forgot-btn"
          class="w-full py-3 bg-warm-brown text-white rounded-xl font-semibold hover:opacity-90 transition"
        >
          Send Reset Link
        </button>

        <p class="text-center text-sm text-deep-taupe pt-2">
          Remember your password?{' '}
          <a href="/login" class="text-warm-brown font-semibold hover:underline">Sign In</a>
        </p>
      </form>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = (import.meta as unknown as { env: Record<string, string> }).env.PUBLIC_SUPABASE_URL ?? '';
  const supabaseAnonKey = (import.meta as unknown as { env: Record<string, string> }).env.PUBLIC_SUPABASE_ANON_KEY ?? '';
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const emailInput = document.getElementById('forgot-email') as HTMLInputElement;
  const successMsg = document.getElementById('forgot-success') as HTMLElement;
  const errorMsg = document.getElementById('forgot-error') as HTMLElement;
  const btn = document.getElementById('forgot-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const email = emailInput.value.trim();

    // Use Supabase to send reset email
    await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/reset-password`,
    });

    // Always show success regardless of whether email exists (security best practice)
    successMsg.classList.remove('hidden');
    btn.textContent = 'Sent';
  });
</script>
