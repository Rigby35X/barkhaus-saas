---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const capabilities = [
  { title: 'Animal records', description: 'Keep an animal’s photos, background, care details, and availability in one shared place. Start with the record and let the rest of the workflow follow.', href: '/features/animals' },
  { title: 'Rescue websites', description: 'Give your organization a home online with pages for your mission, your animals, and the ways people can help.', href: '/features/public-website' },
  { title: 'Applications', description: 'Collect adoption, foster, and volunteer interest, then review submissions in an organized workspace.', href: '/features/applications' },
  { title: 'Content and outreach', description: 'Turn animal information into a starting point for social captions and community updates. Your team reviews what to share.', href: '/features/social-media' },
  { title: 'Conversations', description: 'Keep incoming questions and contact submissions visible to the people who need to respond.', href: '/features/inbox' },
  { title: 'Your organization’s identity', description: 'Bring your rescue’s logo, colors, and story to the public experience.', href: '/features/branding' },
];
---
<BaseLayout title="The BarkHaus platform" description="Explore how BarkHaus connects animal records, rescue websites, applications, and community outreach.">
  <Navbar currentPage="/features" />
  <main>
    <section class="bh-page"><div class="bh-container"><p class="bh-overline">THE PLATFORM</p><h1>Everything starts with the animals in your care.</h1><p class="bh-lead">The BarkHaus vision is one connected workspace for the daily work of rescue. Keep the information your team needs close to the public experiences that help animals find homes.</p><a class="bh-button bh-button-primary" href="/contact">Tell us about your rescue <span aria-hidden="true">↗</span></a></div></section>
    <section class="bh-content"><div class="bh-container"><p class="bh-overline">THE CORE WORKFLOW</p><h2>From intake to a new beginning</h2><div class="bh-capability"><h3>01 · Create a record</h3><p>Add the photos, story, care details, and availability that make up an animal’s profile.</p></div><div class="bh-capability"><h3>02 · Put the story to work</h3><p>Present available animals on your public site, with a clear route for people to learn more and apply.</p></div><div class="bh-capability"><h3>03 · Move together</h3><p>Review interest, track the next steps, and update the animal’s status as the journey changes.</p></div></div></section>
    <section class="bh-content" style="background:#f0e8df"><div class="bh-container"><p class="bh-overline">EXPLORE THE WORKSPACE</p><h2>Tools for the whole rescue journey</h2>{capabilities.map(item => <div class="bh-capability"><h3>{item.title}</h3><div><p>{item.description}</p><a href={item.href}>Explore {item.title.toLowerCase()} ↗</a></div></div>)}<p class="bh-note">BarkHaus is in active development. Capabilities and availability may vary as we work with early rescue partners. Petfinder, Stripe, and other third-party integrations are planned and are not presented as live connections.</p></div></section>
    <section class="bh-cta"><div class="bh-container bh-cta-inner"><div><p class="bh-overline">HELP SHAPE WHAT COMES NEXT</p><h2>Tell us how your rescue works.</h2><p>We’d like to learn which handoffs cost your team the most time.</p></div><a class="bh-button bh-button-light" href="/contact">Start a conversation ↗</a></div></section>
  </main><Footer />
</BaseLayout>
