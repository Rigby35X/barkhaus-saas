---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Continue to BarkHaus">
  <main class="min-h-screen bg-cloud flex items-center justify-center p-6">
    <section class="bg-white rounded-2xl p-8 max-w-md text-center space-y-4">
      <h1 class="font-serif text-2xl">Continue to BarkHaus</h1>
      <p>This link opened our previous sign-in page. Continue to your workspace and sign in there.</p>
      <a id="workspace-login" class="block underline text-warm-brown">Continue to sign in</a>
      <p id="connection-error" role="alert" hidden>Sign-in is temporarily unavailable. Please contact BarkHaus.</p>
    </section>
  </main>
</BaseLayout>

<script>
  import { workspaceAuthUrl } from '../../lib/workspace-auth';
  // Legacy callbacks never forward tokens/codes across origins or pretend that
  // a session established here also signs the user into the dashboard.
  window.history.replaceState(null, '', window.location.pathname);
  try {
    const link = document.getElementById('workspace-login') as HTMLAnchorElement;
    link.href = workspaceAuthUrl(import.meta.env.PUBLIC_APP_URL, 'login');
  } catch { document.getElementById('connection-error')?.removeAttribute('hidden'); }
</script>
