---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="My Dog Cinco" description="The story of Cinco — the inspiration behind Barkhaus.">
  <Navbar currentPage="/my-dog-cinco" />

  <main class="pt-24">

    <!-- Hero -->
    <div class="bg-cloud py-20 text-center">
      <div class="max-w-3xl mx-auto px-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-warm-brown mb-3">The Dog Behind It All</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-deep-taupe mb-6">Meet Cinco</h1>
        <p class="text-lg text-stone leading-relaxed">
          Every product has an origin story. Ours has four legs, a wagging tail, and a serious
          case of the zoomies. This is Cinco's story — and how he inspired Barkhaus.
        </p>
      </div>
    </div>

    <!-- Story -->
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-10">

        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="font-serif text-3xl font-bold text-deep-taupe mb-4">A Rescue Dog Who Changed Everything</h2>
            <p class="text-stone leading-relaxed mb-4">
              Cinco came into our lives through a local rescue organization. The adoption process
              was a mess of paper forms, unreturned emails, and a website that looked like it hadn't
              been updated since 2008. We almost gave up.
            </p>
            <p class="text-stone leading-relaxed">
              But Cinco made it worth it. And watching the rescue scramble to manage everything with
              spreadsheets and email threads planted a seed: what if shelters had better tools?
            </p>
          </div>
          <div class="bg-dove rounded-3xl h-64 flex items-center justify-center">
            <span class="text-8xl">🐕</span>
          </div>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="order-2 lg:order-1 bg-dove rounded-3xl h-64 flex items-center justify-center">
            <span class="text-8xl">🏠</span>
          </div>
          <div class="order-1 lg:order-2">
            <h2 class="font-serif text-3xl font-bold text-deep-taupe mb-4">From Frustration to a Platform</h2>
            <p class="text-stone leading-relaxed mb-4">
              After bringing Cinco home, we went back to the rescue and asked: "What do you actually
              need?" The answer was everything — a website, an intake system, a way to post on social
              media without it taking half a day.
            </p>
            <p class="text-stone leading-relaxed">
              We built the first version of Barkhaus in a spare bedroom. Cinco supervised from the couch.
            </p>
          </div>
        </div>

        <div class="bg-cloud rounded-3xl p-10 text-center">
          <p class="font-serif text-2xl font-semibold text-deep-taupe italic mb-4">
            "Every dog deserves a second chance. Every rescue deserves tools that actually work."
          </p>
          <p class="text-sm text-stone">— The team at Barkhaus</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-deep-taupe mb-4">Cinco Today</h2>
          <p class="text-stone leading-relaxed mb-4">
            Cinco is doing great. He's six years old now, slightly less enthusiastic about mornings
            than he used to be, and absolutely convinced that he's a lap dog despite weighing 65 pounds.
          </p>
          <p class="text-stone leading-relaxed">
            He's also the unofficial mascot of Barkhaus. Every product decision we make, we ask:
            would this have made adopting Cinco easier? If yes, it ships.
          </p>
        </div>

      </div>
    </section>

    <CTABanner
      headline="Help More Dogs Find Their Cinco Moment"
      subtext="Give your rescue the tools to connect every animal with a loving home."
      primaryCta={{ label: 'Start Free Trial', href: '/signup' }}
      secondaryCta={{ label: 'Learn More', href: '/features' }}
    />

  </main>

  <Footer />
</BaseLayout>
