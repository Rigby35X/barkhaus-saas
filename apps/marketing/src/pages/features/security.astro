---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Secure Org Access" description="Each organization gets fully isolated data with secure access codes. No shared databases, no cross-tenant data leaks.">
  <Navbar currentPage="/features" />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-cloud">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-warm-brown mb-3">Security</p>
      <div class="text-5xl mb-6">🔒</div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-deep-taupe mb-6">Your Data Is Yours — and Only Yours</h1>
      <p class="text-xl text-deep-taupe max-w-2xl mx-auto leading-relaxed">Each organization gets fully isolated data with secure access codes. No shared databases, no cross-tenant data leaks.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-10">
        <a href="/signup" class="px-8 py-3 bg-warm-brown text-white rounded-xl font-semibold hover:opacity-90 transition">Start Free Trial</a>
        <a href="/features" class="px-8 py-3 border border-deep-taupe/30 text-deep-taupe rounded-xl font-semibold hover:bg-white transition">All Features</a>
      </div>
    </div>
  </section>

  <!-- Detail section -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="font-serif text-3xl font-bold text-deep-taupe mb-5">How It Works</h2>
          <p class="text-deep-taupe leading-relaxed mb-8">Barkhaus is built from the ground up with multi-tenancy security. Your organization's data — animals, applications, content, settings — is completely isolated from every other org. Access requires both a valid account and your organization's unique code. No data ever crosses org boundaries.</p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-warm-brown/10 text-warm-brown flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </span>
              <span class="text-deep-taupe">Fully isolated data per organization — no shared tables</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-warm-brown/10 text-warm-brown flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </span>
              <span class="text-deep-taupe">Org access codes add a second authentication layer</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-warm-brown/10 text-warm-brown flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </span>
              <span class="text-deep-taupe">Supabase row-level security enforced at the database level</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-warm-brown/10 text-warm-brown flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </span>
              <span class="text-deep-taupe">No cross-tenant data access possible by design</span>
            </li>
          </ul>
        </div>
        <div class="bg-cloud rounded-3xl p-10 flex items-center justify-center min-h-64">
          <div class="text-center">
            <div class="text-8xl mb-4">🔒</div>
            <p class="font-serif font-semibold text-deep-taupe">Secure Org Access</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    headline="Ready to Get Started?"
    subtext="Start your free 14-day trial today. No credit card required."
    primaryCta={{ label: 'Start Free Trial', href: '/signup' }}
    secondaryCta={{ label: 'See all features', href: '/features' }}
  />

  <Footer />
</BaseLayout>
