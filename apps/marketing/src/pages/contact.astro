---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Talk to BarkHaus" description="Get in touch about BarkHaus early access, rescue workflows, and partnerships.">
  <Navbar currentPage="/contact" />
  <main><section class="bh-page"><div class="bh-container"><p class="bh-overline">GET IN TOUCH</p><h1>Tell us about your rescue.</h1><p class="bh-lead">What takes too much time today? Which tools do you wish worked together? We'd love to hear your story and talk about whether BarkHaus can help.</p><a class="bh-button bh-button-primary" href="mailto:hello@barkhaus.io?subject=BarkHaus%20early%20access">Email hello@barkhaus.io ↗</a><p class="bh-hero-note">Your email app will open so you can send your message directly.</p></div></section>
  <section class="bh-content"><div class="bh-container" style="max-width:850px"><p class="bh-overline">GOOD THINGS TO INCLUDE</p><h2>Help us understand your day to day.</h2><div class="bh-capability"><h3>Your organization</h3><p>What kind of rescue or shelter do you run, and how many people help manage the work?</p></div><div class="bh-capability"><h3>Your current workflow</h3><p>How do you manage animal records, applications, your public site, and outreach today?</p></div><div class="bh-capability"><h3>Your biggest handoff</h3><p>Where does information get copied, lost, or delayed?</p></div></div></section></main><Footer />
</BaseLayout>
