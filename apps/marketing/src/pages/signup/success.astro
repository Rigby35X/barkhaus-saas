---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const APP_URL = import.meta.env.VITE_APP_URL ?? 'https://app.barkhaus.io';
---

<BaseLayout title="Welcome to Barkhaus!" description="Your Barkhaus account is ready.">
  <Navbar />

  <main class="min-h-screen bg-cloud pt-24 pb-16 px-4 flex items-center">
    <div class="bg-white rounded-2xl shadow-xl max-w-md mx-auto p-10 text-center w-full">
      <div class="text-6xl mb-6">🎉</div>
      <h1 class="font-serif text-3xl font-bold text-deep-taupe mb-3">Welcome to Barkhaus!</h1>
      <p class="text-deep-taupe mb-8">Your Professional account is active. Let's get your rescue set up.</p>
      <a
        href={APP_URL}
        class="inline-block px-8 py-3 bg-warm-brown text-white rounded-xl font-semibold hover:opacity-90 transition text-sm"
      >
        Go to Dashboard
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
