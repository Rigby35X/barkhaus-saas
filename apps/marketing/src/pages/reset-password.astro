---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Reset Password" description="Set a new password for your Barkhaus account.">
  <Navbar currentPage="/reset-password" />

  <main class="min-h-screen bg-cloud pt-24 pb-16 px-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md mx-auto p-8 mt-8">
      <div class="text-center mb-6">
        <a href="/"><img src="/images/logos/6.png" alt="Barkhaus" class="h-10 w-auto mx-auto" /></a>
      </div>

      <div class="text-center mb-8">
        <h2 class="font-serif text-2xl font-bold text-deep-taupe mb-2">Set New Password</h2>
        <p class="text-deep-taupe">Enter your new password below.</p>
      </div>

      <form id="reset-form" class="space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold text-deep-taupe uppercase tracking-wider mb-1">New Password</label>
          <input
            type="password"
            id="new-password"
            placeholder="Min. 8 characters"
            required
            minlength="8"
            class="w-full border border-silver-gray rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-warm-brown"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-deep-taupe uppercase tracking-wider mb-1">Confirm Password</label>
          <input
            type="password"
            id="confirm-password"
            placeholder="Re-enter new password"
            required
            class="w-full border border-silver-gray rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-warm-brown"
          />
        </div>

        <div id="reset-success" class="hidden text-sm text-green-700 bg-green-50 rounded-xl px-3 py-2">
          Password updated! <a href="/login" class="font-semibold underline">Sign in</a>
        </div>
        <div id="reset-error" class="hidden text-sm text-red-600 bg-red-50 rounded-xl px-3 py-2"></div>

        <button
          type="submit"
          id="reset-btn"
          class="w-full py-3 bg-warm-brown text-white rounded-xl font-semibold hover:opacity-90 transition"
        >
          Update Password
        </button>
      </form>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = (import.meta as unknown as { env: Record<string, string> }).env.PUBLIC_SUPABASE_URL ?? '';
  const supabaseAnonKey = (import.meta as unknown as { env: Record<string, string> }).env.PUBLIC_SUPABASE_ANON_KEY ?? '';
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const newPw = document.getElementById('new-password') as HTMLInputElement;
  const confirmPw = document.getElementById('confirm-password') as HTMLInputElement;
  const successMsg = document.getElementById('reset-success') as HTMLElement;
  const errorMsg = document.getElementById('reset-error') as HTMLElement;
  const btn = document.getElementById('reset-btn') as HTMLButtonElement;

  // Extract token from URL hash (Supabase puts it there)
  const hash = new URLSearchParams(window.location.hash.slice(1));
  const accessToken = hash.get('access_token');
  const refreshToken = hash.get('refresh_token');

  if (accessToken && refreshToken) {
    await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');

    if (newPw.value.length < 8) {
      errorMsg.textContent = 'Password must be at least 8 characters.';
      errorMsg.classList.remove('hidden');
      return;
    }
    if (newPw.value !== confirmPw.value) {
      errorMsg.textContent = 'Passwords do not match.';
      errorMsg.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Updating…';

    const { error } = await supabase.auth.updateUser({ password: newPw.value });
    if (error) {
      errorMsg.textContent = error.message;
      errorMsg.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Update Password';
    } else {
      successMsg.classList.remove('hidden');
      btn.textContent = 'Done';
    }
  });
</script>
