{
  "version": 2,
  "installCommand": "cd ../.. && npm install --include=optional && cd apps/tenant-site && npm install --include=optional",
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/$1" }],
  "env": {
    "NODE_TLS_REJECT_UNAUTHORIZED": "0"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://app.barkhaus.io" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/images/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
    },
    {
      "source": "/(.*).html",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60"}]
    }
  ]
}
