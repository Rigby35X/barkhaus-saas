---
import MBPRLayout from "../layouts/MBPRLayout.astro";
import FeaturedAnimals from "../components/mbpr/FeaturedAnimals.astro";
---
<MBPRLayout title="Home | Mission Bay Puppy Rescue" description="Mission Bay Puppy Rescue is a San Diego non-profit finding loving homes for rescue puppies and their mamas.">
<section class="hero">
  <div class="hero-media">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_97593c5f-9a3b-4c8f-88ab-e5c619b83289_1200x1200.jpg?v=1787949564">
      <source src="https://raw.githubusercontent.com/Rigby35X/mbpr-mockup/main/assets/videos/homepage-puppies.m4v" type="video/mp4">
      Your browser does not support video playback.
    </video>
    <div class="hero-caption">
      <span class="eyebrow on-dark">San Diego &middot; Since 2022 &middot; 30 Years of Rescue</span>
      <h1>Happy. Simple.<br>Puppy&#8209;First.</h1>
      <p class="lede">Watch our puppies in action.</p>
    </div>
  </div>
  <div class="hero-actions">
    <a class="btn btn-gold" href="/available-pups">Meet the Pups</a>
    <a class="btn btn-outline on-dark" href="/adopt">Apply to Adopt</a>
   <!-- <a class="faq-quiet" href="/faq">Have questions first? Read the FAQ &rarr;</a> -->
  </div>
</section>
<svg class="wave-divider" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
  <path class="w2" d="M0,40 C 240,90 480,0 720,30 C 960,60 1200,10 1440,40 L1440,90 L0,90 Z"></path>
  <path class="w1" d="M0,55 C 240,20 480,80 720,50 C 960,20 1200,70 1440,45 L1440,90 L0,90 Z"></path>
</svg>

<section class="section tight"><div class="container"><div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:30px;"><div><span class="eyebrow">Meet the MBPR Pups</span><h2 style="margin-bottom:0;">Pups Looking For Homes</h2></div><a class="link-quiet" href="/available-pups">See All Available Pups &rarr;</a></div><FeaturedAnimals /></div></section>

<section class="section sand-deep">
  <div class="container split">
    <div class="content-flow">
      <span class="eyebrow">Our Story</span>
      <h2>30 Years Of Puppies On Our Front Lawn</h2>
      <p class="lede">It started with a family of 10 puppies in our front yard. Today Mission Bay Puppy Rescue is an official 501(c)(3), still run the same way &mdash; in our own home, with a whole lot of love.</p>
      <a class="btn btn-navy" href="/about">Read Our Full Story</a>
    </div>
    <div class="media">
      <img src="/mbpr-story-family.jpg" alt="Mission Bay Puppy Rescue founders holding rescue puppies">
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="eyebrow">Three Ways To Help</span>
    <h2 style="margin-bottom:34px;">Say Yes With Us</h2>
    <div class="action-blocks help-action-blocks">
      <div class="action-block help-action-card help-action-card--white">
        <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M4 11.5L12 4l8 7.5"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/></svg></div>
        <h3>Adopt</h3>
        <p>Bring home a rescue pup or a mama who&rsquo;s ready for her forever family.</p>
        <a class="btn btn-navy btn-sm help-action-card__button" href="/adopt">Start an Application</a>
      </div>
      <div class="action-block help-action-card help-action-card--light">
        <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M12 20s-7.5-4.6-9.5-9C1 7.5 3 4 6.5 4c2 0 3.4 1.2 4 2 .6-.8 2-2 4-2C18 4 20 7.5 18.5 11c-2 4.4-6.5 9-6.5 9z"/></svg></div>
        <h3>Foster</h3>
        <p>Open your home short-term so we can say yes when a shelter calls.</p>
        <a class="btn btn-outline btn-sm help-action-card__button" href="/foster">Learn About Fostering</a>
      </div>
      <div class="action-block help-action-card help-action-card--dark">
        <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="1.2"/><path d="M4 13h16"/><path d="M12 9v11"/><path d="M12 9C10.5 9 8.5 8 8.5 6.2 8.5 5 9.4 4 10.6 4c1.6 0 1.9 2.5 1.4 5zM12 9c1.5 0 3.5-1 3.5-2.8 0-1.2-.9-2.2-2.1-2.2-1.6 0-1.9 2.5-1.4 5z"/></svg></div>
        <h3>Donate</h3>
        <p>Cover vet bills, food, and care for pups waiting on their people.</p>
        <a class="btn btn-gold btn-sm help-action-card__button" href="/donate">Give Today</a>
      </div>
    </div>
  </div>
</section>

<section class="section navy">
  <div class="container">
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom:30px;">
      <div>
        <span class="eyebrow on-dark">Follow Along</span>
        <h2 style="margin-bottom:0;">We Love To Socialize</h2>
      </div>
      <a class="btn btn-outline on-dark btn-sm" href="https://www.instagram.com/missionbaypuppyrescue" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/></svg> @missionbaypuppyrescue</a>
    </div>
    <div class="mbpr-instagram-feed" aria-label="Mission Bay Puppy Rescue Instagram feed">
      <script src="https://static.elfsight.com/apps/instashow/release/d53d46de683ab6044fe527fb28ffa7969e6ced98/app/instashow.js"></script>
      <div class="elfsight-sapp-96a60933-f1e0-4152-95e9-e14c143ca70f"></div>
    </div>
  </div>
</section>
</MBPRLayout>