---
import MBPRLayout from "../layouts/MBPRLayout.astro";
---
<MBPRLayout title="Rocket | Mission Bay Puppy Rescue" description="Rocket is a cattle dog mix puppy from Mission Bay Puppy Rescue">
<section class="section tight">
  <div class="container">
    <a class="back-link" href="/available-pups"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg> Back to Available Pups</a>

    <div class="split" style="align-items:flex-start;">
      <div class="gallery">
        <div class="main-shot"><img src="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_97593c5f-9a3b-4c8f-88ab-e5c619b83289_1200x1200.jpg?v=1787949564" alt="Rocket, a male cattle dog mix puppy, main photo"></div>
        <div class="sub-shot"><img src="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_19d56075-bd12-49f5-adce-cb64dec34d37.jpg?v=1787949564" alt="Rocket playing outside"></div>
        <div class="sub-shot" style="display:flex;align-items:center;justify-content:center;color:var(--bay-navy);opacity:.3;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M5 8.5c0-2 1.4-3.5 3-3.5.9 0 1.6.6 2 1 .8-.4 1.9-.6 3-.6s2.2.2 3 .6c.4-.4 1.1-1 2-1 1.6 0 3 1.5 3 3.5 0 1.3-.6 2.4-1.5 3l.5 2c.3 1.5-.7 3-2.3 3H8.3c-1.6 0-2.6-1.5-2.3-3l.5-2C5.6 10.9 5 9.8 5 8.5z"/><circle cx="9.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/></svg><span class="visually-hidden">Baby photo placeholder</span></div>
      </div>

      <div>
        <span class="status-ribbon status-available" style="position:static; display:inline-flex; margin-bottom:14px;">Available Now</span>
        <h1 style="margin-bottom:4px;">Rocket</h1>
        <p class="lede" style="margin-bottom:22px;">Part of &ldquo;The 17!&rdquo; litter &middot; Aust. Cattle Dog / Mix</p>

        <div style="display:flex; flex-wrap:wrap; gap:14px; margin-bottom:26px;">
          <a class="btn btn-gold" href="/adopt">Apply to Adopt Rocket</a>
          <a class="btn btn-outline" href="/faq">Adoption FAQ</a>
        </div>

        <div class="quick-facts" style="margin-bottom:26px;">
          <div class="fact"><div class="k">Sex</div><div class="v">Male</div></div>
          <div class="fact"><div class="k">Breed / Mix</div><div class="v">Cattle Dog Mix</div></div>
          <div class="fact"><div class="k">Adult Size</div><div class="v">Medium, 25&ndash;50 lbs</div></div>
          <div class="fact"><div class="k">Birthday</div><div class="v">May 5, 2026</div></div>
        </div>

        <h3>About Rocket</h3>
        <p style="opacity:.85;">Rocket is one of 17 puppies born after his mama was rescued mid-pregnancy by the County and brought to Mission Bay Puppy Rescue. He&rsquo;s playful, curious, and getting more confident every single day &mdash; ready to grow into his name with the right family by his side.</p>

        <div style="margin-top:22px; padding:18px 20px; background:var(--sand-deep); border-radius:var(--radius-md); border:1px solid var(--sand-line);">
          <p style="margin:0; font-size:.92rem;"><strong>Curious about his littermates?</strong> Rocket is one of six from &ldquo;The 17!&rdquo; still looking for homes.</p>
          <a class="link-quiet" href="/available-pups#litter-the-17" style="margin-top:8px; display:inline-block;">Meet the Whole Litter &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section sand-deep">
  <div class="container">
    <span class="eyebrow">More Available Pups</span>
    <h2 style="margin-bottom:26px;">Keep Browsing</h2>
    <div class="grid grid-4">
      <div class="pup-card">
        <div class="pup-photo"><span class="status-ribbon status-available">Available Now</span><img src="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_33f34ac5-e50e-457b-8ea1-79d23812d814_1200x1200.jpg?v=1787949952" alt="Liberty"></div>
        <div class="pup-body"><h3 class="pup-name">Liberty</h3><div class="pup-facts"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M5 8.5c0-2 1.4-3.5 3-3.5.9 0 1.6.6 2 1 .8-.4 1.9-.6 3-.6s2.2.2 3 .6c.4-.4 1.1-1 2-1 1.6 0 3 1.5 3 3.5 0 1.3-.6 2.4-1.5 3l.5 2c.3 1.5-.7 3-2.3 3H8.3c-1.6 0-2.6-1.5-2.3-3l.5-2C5.6 10.9 5 9.8 5 8.5z"/><circle cx="9.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/></svg> Female</span></div></div>
      </div>
      <div class="pup-card">
        <div class="pup-photo"><span class="status-ribbon status-available">Available Now</span><img src="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_4a73e74a-e59f-4e12-87a9-04cf0403e91f_1200x1200.jpg?v=1787949454" alt="Captain"></div>
        <div class="pup-body"><h3 class="pup-name">Captain</h3><div class="pup-facts"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M5 8.5c0-2 1.4-3.5 3-3.5.9 0 1.6.6 2 1 .8-.4 1.9-.6 3-.6s2.2.2 3 .6c.4-.4 1.1-1 2-1 1.6 0 3 1.5 3 3.5 0 1.3-.6 2.4-1.5 3l.5 2c.3 1.5-.7 3-2.3 3H8.3c-1.6 0-2.6-1.5-2.3-3l.5-2C5.6 10.9 5 9.8 5 8.5z"/><circle cx="9.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/></svg> Male</span></div></div>
      </div>
      <div class="pup-card">
        <div class="pup-photo"><span class="status-ribbon status-available">Available Now</span><img src="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_fb230a69-4c82-4381-801b-1b9285c49ab1_1200x1200.jpg?v=1787949477" alt="Banner"></div>
        <div class="pup-body"><h3 class="pup-name">Banner</h3><div class="pup-facts"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M5 8.5c0-2 1.4-3.5 3-3.5.9 0 1.6.6 2 1 .8-.4 1.9-.6 3-.6s2.2.2 3 .6c.4-.4 1.1-1 2-1 1.6 0 3 1.5 3 3.5 0 1.3-.6 2.4-1.5 3l.5 2c.3 1.5-.7 3-2.3 3H8.3c-1.6 0-2.6-1.5-2.3-3l.5-2C5.6 10.9 5 9.8 5 8.5z"/><circle cx="9.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/></svg> Male</span></div></div>
      </div>
      <div class="pup-card">
        <div class="pup-photo"><span class="status-ribbon status-available">Available Now</span><img src="https://missionbaypuppyrescue.org/cdn/shop/files/fGT316vhT0-rU8gCrayexQ_0f7869ce-6513-4ec1-82f9-dde97ae70632_1200x1200.jpg?v=1787949827" alt="Glory"></div>
        <div class="pup-body"><h3 class="pup-name">Glory</h3><div class="pup-facts"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M5 8.5c0-2 1.4-3.5 3-3.5.9 0 1.6.6 2 1 .8-.4 1.9-.6 3-.6s2.2.2 3 .6c.4-.4 1.1-1 2-1 1.6 0 3 1.5 3 3.5 0 1.3-.6 2.4-1.5 3l.5 2c.3 1.5-.7 3-2.3 3H8.3c-1.6 0-2.6-1.5-2.3-3l.5-2C5.6 10.9 5 9.8 5 8.5z"/><circle cx="9.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/></svg> Female</span></div></div>
      </div>
    </div>
  </div>
</section>
</MBPRLayout>