---
import MBPRLayout from "../layouts/MBPRLayout.astro";

const centers = [
  {
    title: "New Puppy Center",
    description: "First days home, sleeping, puppy pen setup, feeding, socialization and more.",
    href: "/resources/new-puppy",
    className: "resource-center-card--blue",
    icon: "⌂",
  },
  {
    title: "Training Center",
    description: "Potty training, crate training, biting, jumping, leash skills, recall and common behaviors.",
    href: "/resources/training",
    className: "resource-center-card--gold",
    icon: "★",
  },
  {
    title: "Vet & Health Center",
    description: "Vaccines, public exposure, spay/neuter, parasites, illness warning signs and vet resources.",
    href: "/resources/vet-health",
    className: "resource-center-card--coral",
    icon: "✚",
  },
  {
    title: "Shopping Center",
    description: "Crates, pens, food, toys, grooming supplies, cleanup products, travel gear and more.",
    href: "/resources/shopping",
    className: "resource-center-card--green",
    icon: "▣",
    id: "shopping-center",
  },
  {
    title: "Rescue & Community Resources",
    description: "Found dogs, owner relinquishment, local shelters, low-cost care and trusted rescue resources.",
    href: "/resources/community",
    className: "resource-center-card--sky",
    icon: "♡",
  },
];

const popularGuides = [
  { title: "Your Puppy’s First Night", center: "New Puppy Center", href: "/resources/new-puppy" },
  { title: "Setting Up Your Puppy Pen", center: "New Puppy Center", href: "/resources/new-puppy" },
  { title: "Potty Training", center: "Training Center", href: "/resources/training" },
  { title: "Puppy Vaccine & Public Exposure Guide", center: "Vet & Health Center", href: "/resources/vet-health" },
  { title: "When To Call The Vet", center: "Vet & Health Center", href: "/resources/vet-health" },
  { title: "What To Buy Before Bringing Puppy Home", center: "Shopping Center", href: "/resources/shopping" },
];
---
<MBPRLayout title="Resource Center | Mission Bay Puppy Rescue" description="Puppy care guides, training help, veterinary information, shopping recommendations, and community rescue resources from Mission Bay Puppy Rescue.">
  <section class="resource-center-hero">
    <div class="container resource-center-hero__inner">
      <div class="resource-center-hero__copy">
        <span class="eyebrow">Resources</span>
        <h1>MBPR Puppy Resource Center</h1>
        <p class="lede">Bringing home a new puppy is exciting — and sometimes a little overwhelming. We&rsquo;ve put our favorite advice, trusted resources, and tried-and-true products all in one place to help you and your puppy get off to the best start.</p>
      </div>
      <div class="resource-center-hero__visual" aria-hidden="true">
        <div class="resource-center-hero__puppy">🐶</div>
        <span>Happy Puppies.<br/>Happier Lives.</span>
      </div>
    </div>
  </section>

  <section class="section tight resource-center-main">
    <div class="container">
      <div class="resource-center-grid">
        {centers.map((center) => (
          <article id={center.id} class:list={["resource-center-card", center.className]}>
            <div class="resource-center-card__media">
              <div class="resource-center-card__icon" aria-hidden="true">{center.icon}</div>
            </div>
            <div class="resource-center-card__body">
              <h2>{center.title}</h2>
              <p>{center.description}</p>
              <a class="btn resource-center-card__button" href={center.href}>Explore {center.title}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section resource-popular">
    <div class="container">
      <div class="resource-section-heading">
        <div>
          <span class="eyebrow">Quick Answers</span>
          <h2>Popular Guides</h2>
        </div>
        <p>Start with the questions MBPR families ask most often.</p>
      </div>
      <div class="resource-guide-grid">
        {popularGuides.map((guide, index) => (
          <a class="resource-guide-card" href={guide.href}>
            <div class:list={["resource-guide-card__visual", `resource-guide-card__visual--${(index % 5) + 1}`]} aria-hidden="true">
              <span>{index + 1}</span>
            </div>
            <div class="resource-guide-card__body">
              <small>{guide.center}</small>
              <h3>{guide.title}</h3>
              <span class="resource-guide-card__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <p class="resource-coming-note">The Resource Center framework is live now. Jackie + Chet can fill in and refine each guide one piece at a time without changing the overall navigation.</p>
    </div>
  </section>

  <section class="section sand-deep" id="other-ways-to-give">
    <div class="container split">
      <div class="content-flow">
        <span class="eyebrow">Other Ways To Give</span>
        <h2>More Ways To Support MBPR</h2>
        <p class="lede">Donations are only one way to help. You can support the rescue through workplace giving, corporate partnerships, wish-list purchases, fostering, and by sharing our work with your community.</p>
        <div style="display:flex; flex-wrap:wrap; gap:12px;">
          <a class="btn btn-gold" href="/donate">See Ways To Give</a>
          <a class="btn btn-outline" href="/foster">Become A Foster</a>
        </div>
      </div>
      <div class="support-mission-card">
        <span class="eyebrow">Every Bit Helps</span>
        <h3>Help Us Keep Saying Yes</h3>
        <p>Whether you donate, foster, shop from our wish list, or connect us with a community partner, your support helps us make room for the next litter, mama, or puppy who needs us.</p>
      </div>
    </div>
  </section>

  <section class="section" id="partners">
    <div class="container">
      <span class="eyebrow">Rescue & Community Partners</span>
      <h2 style="margin-bottom:26px;">Same Goal: Homes For Pups In Need</h2>
      <div class="grid grid-4">
        <div class="resource-tile">
          <div class="icon-badge" aria-hidden="true">⌖</div>
          <h4>County Animal Shelter</h4>
          <p>See available pets at San Diego County Animal Shelters.</p>
          <a class="link-quiet" href="https://www.sddac.com/content/sdc/das/adopt.html" target="_blank" rel="noopener">View Pets &rarr;</a>
        </div>
        <div class="resource-tile">
          <div class="icon-badge" aria-hidden="true">⌖</div>
          <h4>San Diego Humane Society</h4>
          <p>See available pets at The San Diego Humane Society.</p>
          <a class="link-quiet" href="https://www.sdhumane.org/adopt/available-pets/" target="_blank" rel="noopener">View Pets &rarr;</a>
        </div>
        <div class="resource-tile">
          <div class="icon-badge" aria-hidden="true">♡</div>
          <h4>Woof Project Rescue</h4>
          <p>A fellow San Diego-area rescue partner.</p>
          <a class="link-quiet" href="https://www.woofproject.org/availabledogs" target="_blank" rel="noopener">View Dogs &rarr;</a>
        </div>
        <div class="resource-tile">
          <div class="icon-badge" aria-hidden="true">♡</div>
          <h4>Pit-Opotamus Puppy Rescue</h4>
          <p>A fellow San Diego-area rescue partner.</p>
          <a class="link-quiet" href="https://www.facebook.com/p/Pit-Opotamus-Puppy-Rescue-100086318779566/" target="_blank" rel="noopener">Visit Page &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</MBPRLayout>
