---
import MBPRLayout from "../layouts/MBPRLayout.astro";

const resourceSections = [
  {
    id: "new-puppy",
    eyebrow: "New Puppy Center",
    title: "Start Strong At Home",
    description: "First days home, sleep, puppy pen setup, feeding, socialization, puppy-proofing, and the questions nearly every new puppy family asks.",
    href: "/resources/new-puppy",
    featured: ["Bringing Your Puppy Home", "The First Night", "Puppy Pen / Safe-Space Setup"],
  },
  {
    id: "training",
    eyebrow: "Training Center",
    title: "Practical Help For Everyday Puppy Problems",
    description: "Simple, useful guidance for potty training, crate training, biting, jumping, leash skills, recall, chewing, barking, and learning to be alone.",
    href: "/resources/training",
    featured: ["Potty Training", "Crate Training", "Puppy Biting / Mouthiness"],
  },
  {
    id: "vet-health",
    eyebrow: "Vet & Health Center",
    title: "Know What To Watch For",
    description: "Educational guidance on vaccines, parasites, public exposure, spay and neuter, common illnesses, and when to call a veterinarian or seek emergency care.",
    href: "/resources/vet-health",
    featured: ["Puppy Vaccine Schedule", "Is My Puppy Sick?", "When It Is An Emergency"],
  },
  {
    id: "shopping-center",
    eyebrow: "Shopping Center",
    title: "What MBPR Actually Uses",
    description: "Practical product recommendations for puppy pens, crates, food, toys, grooming, cleanup, travel, and puppy-proofing — focused on what is genuinely useful.",
    href: "/resources/shopping",
    featured: ["Puppy Pens", "Crates", "Toys & Chews"],
  },
  {
    id: "community",
    eyebrow: "Rescue & Community Resources",
    title: "Help Beyond Adoption",
    description: "Resources for found dogs, lost pets, owner relinquishment, local shelters, low-cost veterinary care, financial assistance, and trusted rescue partners.",
    href: "/resources/community",
    featured: ["I Found A Dog", "Owner Relinquishment", "Low-Cost Veterinary Care"],
  },
];
---
<MBPRLayout title="Resource Center | Mission Bay Puppy Rescue" description="Puppy care guides, training help, veterinary information, shopping recommendations, and community rescue resources from Mission Bay Puppy Rescue.">
  <section class="page-intro resource-hub-hero">
    <div class="container">
      <span class="eyebrow">Resources</span>
      <h1>MBPR Puppy Resource Center</h1>
      <p class="lede resource-hub-hero__lede">Bringing home a new puppy is exciting — and sometimes a little overwhelming. We&rsquo;ve put our favorite advice, trusted resources, and tried-and-true products in one place to help you and your puppy get off to the best start.</p>

      <nav class="resource-hub-nav" aria-label="Resource Center categories">
        {resourceSections.map((section) => (
          <a href={`#${section.id}`}>{section.eyebrow}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="resource-hub-sections">
    {resourceSections.map((section, index) => (
      <section id={section.id} class:list={["resource-hub-section", index % 2 === 1 && "resource-hub-section--tint"]}>
        <div class="container resource-hub-section__grid">
          <div class="resource-hub-section__intro">
            <span class="eyebrow">{section.eyebrow}</span>
            <h2>{section.title}</h2>
            <p>{section.description}</p>
            <a class="btn btn-navy" href={section.href}>Explore {section.eyebrow}</a>
          </div>

          <div class="resource-featured-list" aria-label={`Featured ${section.eyebrow} guides`}>
            {section.featured.map((item, itemIndex) => (
              <a class="resource-featured-item" href={section.href}>
                <span class="resource-featured-item__number">{String(itemIndex + 1).padStart(2, "0")}</span>
                <span class="resource-featured-item__title">{item}</span>
                <span class="resource-featured-item__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </section>

  <section class="section sand-deep" id="other-ways-to-give">
    <div class="container split">
      <div class="content-flow">
        <span class="eyebrow">Other Ways To Give</span>
        <h2>More Ways To Support MBPR</h2>
        <p class="lede">Donations are only one way to help. You can support the rescue through workplace giving, corporate partnerships, wish-list purchases, fostering, and by sharing our work with your community.</p>
        <div style="display:flex; flex-wrap:wrap; gap:12px;">
          <a class="btn btn-gold" href="/donate">See Ways To Give</a>
          <a class="btn btn-outline" href="/foster">Become A Foster</a>
        </div>
      </div>
      <div class="support-mission-card">
        <span class="eyebrow">Every Bit Helps</span>
        <h3>Help Us Keep Saying Yes</h3>
        <p>Whether you donate, foster, shop from our wish list, or connect us with a community partner, your support helps us make room for the next litter, mama, or puppy who needs us.</p>
      </div>
    </div>
  </section>

  <section class="section" id="partners">
    <div class="container">
      <span class="eyebrow">Rescue & Community Partners</span>
      <h2 style="margin-bottom:26px;">Same Goal: Homes For Pups In Need</h2>
      <div class="grid grid-4">
        <div class="resource-tile">
          <h4>County Animal Shelter</h4>
          <p>See available pets at San Diego County Animal Shelters.</p>
          <a class="link-quiet" href="https://www.sddac.com/content/sdc/das/adopt.html" target="_blank" rel="noopener">View Pets &rarr;</a>
        </div>
        <div class="resource-tile">
          <h4>San Diego Humane Society</h4>
          <p>See available pets at The San Diego Humane Society.</p>
          <a class="link-quiet" href="https://www.sdhumane.org/adopt/available-pets/" target="_blank" rel="noopener">View Pets &rarr;</a>
        </div>
        <div class="resource-tile">
          <h4>Woof Project Rescue</h4>
          <p>A fellow San Diego-area rescue partner.</p>
          <a class="link-quiet" href="https://www.woofproject.org/availabledogs" target="_blank" rel="noopener">View Dogs &rarr;</a>
        </div>
        <div class="resource-tile">
          <h4>Pit-Opotamus Puppy Rescue</h4>
          <p>A fellow San Diego-area rescue partner.</p>
          <a class="link-quiet" href="https://www.facebook.com/p/Pit-Opotamus-Puppy-Rescue-100086318779566/" target="_blank" rel="noopener">Visit Page &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</MBPRLayout>
