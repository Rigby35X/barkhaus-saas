---
import MBPRLayout from "../layouts/MBPRLayout.astro";
---
<MBPRLayout title="Relinquishment Form | Mission Bay Puppy Rescue" description="If you">
<section class="page-intro">
  <div class="container">
    <span class="eyebrow">Surrendering A Pet</span>
    <h1>Relinquishment Form</h1>
    <p class="lede">If you've found a lost or stray dog, please take them to the San Diego Humane Society first. For all other relinquishments, use the form below.</p>
  </div>
</section>
<section class="section tight">
  <div class="container">
    <div style="max-width:640px; margin:0 auto; background:var(--white); border:1px solid var(--sand-line); border-radius:var(--radius-lg); box-shadow:var(--shadow-md); padding:42px 30px; text-align:center;">
      <div style="width:52px;height:52px;border-radius:16px;background:var(--gold-pale);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--gold-deep);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><rect x="6" y="4.5" width="12" height="16" rx="1.5"/><rect x="9" y="3" width="6" height="3" rx="1"/><path d="M9 11h6M9 14.5h6M9 17.5h3.5"/></svg></div>
      <h3>Cognito Relinquishment Form Embeds Here</h3>
      <p style="opacity:.75;">[DRAFT &mdash; final form fields pending]<span class="draft-flag">Content Needed</span></p>
    </div>
  </div>
</section>
</MBPRLayout>