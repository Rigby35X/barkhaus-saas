---
import MBPRLayout from "../layouts/MBPRLayout.astro";
---
<MBPRLayout title="Testimonials | Mission Bay Puppy Rescue" description="Read what Mission Bay Puppy Rescue adopters and supporters say about their experience with MBPR.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Happy Tails</span>
      <h1>What Our Families Say</h1>
      <p class="lede">Real stories and reviews from the people who have welcomed MBPR pups into their homes.</p>
    </div>
  </section>

  <section class="section tight testimonial-page">
    <div class="container">
      <div class="testimonial-widget-wrap">
        <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
        <div class="elfsight-app-3d7df505-5c5d-4fa1-a984-7322ab7e01ac" data-elfsight-app-lazy></div>
      </div>
    </div>
  </section>

  <section class="section sand-deep">
    <div class="container testimonial-share-cta">
      <div>
        <span class="eyebrow">Adopted From MBPR?</span>
        <h2>Share Your Happy Tail</h2>
        <p>We love seeing where our pups land. Tell us how your MBPR dog is doing and share your story with the rescue community.</p>
      </div>
      <a class="btn btn-gold" href="/happy-tails">Share Your Story</a>
    </div>
  </section>
</MBPRLayout>
