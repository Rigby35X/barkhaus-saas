---
import MBPRLayout from "../layouts/MBPRLayout.astro";
import AnimalsGrid from "../components/mbpr/AnimalsGrid.astro";
---
<MBPRLayout title="Available Pups | Mission Bay Puppy Rescue" description="See every puppy and rescue dog currently available for adoption at Mission Bay Puppy Rescue in San Diego.">
  <section class="animal-page-hero">
    <div class="container animal-page-hero__inner">
      <div>
        <span class="eyebrow">Meet the pack</span>
        <h1>Available Pups</h1>
      </div>
      <p class="lede">Meet the dogs currently looking for homes. Littermates stay grouped together, and every profile is kept current from our rescue records.</p>
    </div>
  </section>

  <section class="animal-catalog-section">
    <div class="container">
      <AnimalsGrid />
    </div>
  </section>

  <section class="section sand-deep pups-cost-support">
    <div class="container">
      <span class="eyebrow" style="justify-content:center; display:flex;">The Cost of Rescue</span>
      <h2 style="text-align:center; margin-bottom:10px;">Every Pup, From Rescue To Home</h2>
      <p class="lede" style="text-align:center; margin:0 auto 26px;">Every available pup represents a significant financial investment in the form of veterinary care, vaccines, spay or neuter surgery, microchipping, food, foster supplies, and sometimes emergency treatment, all before adoption day.</p>
      <div class="cost-orbit">
        <div class="cost-bubble"><span class="dot"></span> <b>Vaccinations</b>&nbsp;&amp; wellness exams</div>
        <div class="cost-bubble"><span class="dot"></span> <b>Spay / Neuter</b> surgery</div>
        <div class="cost-bubble"><span class="dot"></span> <b>Microchipping</b></div>
        <div class="cost-bubble"><span class="dot"></span> <b>Food</b>&nbsp;&amp; daily care</div>
        <div class="cost-bubble"><span class="dot"></span> <b>Emergency</b>&nbsp;medical care</div>
        <div class="cost-bubble"><span class="dot"></span> <b>Foster</b>&nbsp;supplies</div>
      </div>
      <div class="pups-cost-support__cta">
        <a class="btn btn-gold" href="/donate">Learn How You Can Help</a>
      </div>
    </div>
  </section>

