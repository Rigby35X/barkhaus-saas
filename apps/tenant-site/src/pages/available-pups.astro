  <section class="animal-application-band">
    <div class="container animal-application-band__inner">
      <div>
        <span class="eyebrow">Don&rsquo;t see the right fit yet?</span>
        <h2>Tell us what you&rsquo;re looking for.</h2>
        <p>We rescue based on need first, not breed. An application helps us learn what kind of dog may be a good match when new pups arrive.</p>
      </div>
      <a class="btn btn-gold" href="/adopt">Start an Application</a>
    </div>
  </section>
  -->
</MBPRLayout>
