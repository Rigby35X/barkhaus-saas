---
import MBPRLayout from "../layouts/MBPRLayout.astro";
---
<MBPRLayout title="Share Your Happy Tail | Mission Bay Puppy Rescue" description="Adopted an MBPR pup? We">
<section class="page-intro">
  <div class="container">
    <span class="eyebrow">Adopter Stories</span>
    <h1>Share Your Happy Tail</h1>
    <p class="lede">Adopted an MBPR pup? We'd love to hear how they're doing — and maybe feature your story.</p>
  </div>
</section>
<section class="section tight">
  <div class="container">
    <div style="max-width:640px; margin:0 auto; background:var(--white); border:1px solid var(--sand-line); border-radius:var(--radius-lg); box-shadow:var(--shadow-md); padding:42px 30px; text-align:center;">
      <div style="width:52px;height:52px;border-radius:16px;background:var(--gold-pale);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--gold-deep);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true"><path d="M12 20s-7.5-4.6-9.5-9C1 7.5 3 4 6.5 4c2 0 3.4 1.2 4 2 .6-.8 2-2 4-2C18 4 20 7.5 18.5 11c-2 4.4-6.5 9-6.5 9z"/></svg></div>
      <h3>Cognito Happy Tails Form Embeds Here</h3>
      <p style="opacity:.75;">[DRAFT &mdash; final form fields pending]<span class="draft-flag">Content Needed</span></p>
    </div>
  </div>
</section>
</MBPRLayout>