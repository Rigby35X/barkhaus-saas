---
import MBPRLayout from "../layouts/MBPRLayout.astro";
---
<MBPRLayout title="Share Your Happy Tail | Mission Bay Puppy Rescue" description="Adopted an MBPR pup? Share your happy tail with Mission Bay Puppy Rescue.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Adopter Stories</span>
      <h1>Share Your Happy Tail</h1>
      <p class="lede">Adopted an MBPR pup? We'd love to hear how they're doing — and maybe feature your story.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="embedded-form-card">
        <span class="eyebrow">Tell Us Your Story</span>
        <h2>Share Your Happy Tail</h2>
        <div class="adoption-form-embed">
          <script src="https://www.cognitoforms.com/f/seamless.js" data-key="fGT316vhT0-rU8gCrayexQ" data-form="14"></script>
        </div>
      </div>
    </div>
  </section>
</MBPRLayout>
