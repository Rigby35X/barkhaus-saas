---
import MBPRLayout from "../../layouts/MBPRLayout.astro";
import AnimalCard from "../../components/mbpr/AnimalCard.astro";
import AnimalFacts from "../../components/mbpr/AnimalFacts.astro";
import AnimalGallery from "../../components/mbpr/AnimalGallery.astro";
import { getPublicAnimal, getPublicAnimals } from "../../lib/public-animals";

const animalKey = Astro.params.animalKey || "";
const animal = await getPublicAnimal(animalKey);

if (!animal) {
  return new Response("Animal not found", { status: 404 });
}

const allAnimals = await getPublicAnimals(Astro.locals);
const moreAnimals = allAnimals
  .filter((item) => item.animal_key && item.animal_key !== animal.animal_key)
  .slice(0, 3);

const formatDate = (value?: string) => {
  if (!value) return "";
  const parsed = new Date(value + (value.length === 10 ? "T12:00:00" : ""));
  return Number.isNaN(parsed.getTime())
    ? value
    : parsed.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
};

const birthday = formatDate(animal.birthday);
const title = `${animal.name} | Mission Bay Puppy Rescue`;
const description = animal.story
  ? animal.story.replace(/<[^>]*>/g, "").slice(0, 155)
  : `Meet ${animal.name}, currently available for adoption from Mission Bay Puppy Rescue.`;
---
<MBPRLayout title={title} description={description}>
  <section class="animal-profile">
    <div class="container">
      <a class="back-link animal-profile__back" href="/available-pups">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
        Back to Available Pups
      </a>

      <div class="animal-profile__hero">
        <AnimalGallery animal={animal} />

        <aside class="animal-profile__summary">
          <span class="animal-profile__status">{animal.status || "Available Now"}</span>
          <h1>{animal.name}</h1>
          {(animal.litter || animal.breed) && (
            <p class="animal-profile__subhead">
              {animal.litter && <>Part of &ldquo;{animal.litter}&rdquo;</>}
              {animal.litter && animal.breed && <span aria-hidden="true"> · </span>}
              {animal.breed}
            </p>
          )}

          <AnimalFacts animal={animal} birthday={birthday} />

          <div class="animal-profile__actions">
            <a class="btn btn-gold" href="/adopt">Apply to Adopt {animal.name}</a>
            <a class="btn btn-outline" href="/faq">Adoption FAQ</a>
          </div>
        </aside>
      </div>

      <div class="animal-profile__story-grid">
        <div class="animal-profile__story">
          <span class="eyebrow">Meet {animal.name}</span>
          <h2>About {animal.name}</h2>
          {animal.story
            ? <div class="animal-story">{animal.story}</div>
            : <p>More about {animal.name} is coming soon.</p>}
        </div>

        <aside class="animal-profile__side-card">
          <span class="eyebrow">Ready to meet?</span>
          <h3>Think {animal.name} could be your match?</h3>
          <p>Start with an adoption application. Our team will review it and help determine whether the fit makes sense for both you and the pup.</p>
          <a class="btn btn-navy btn-block" href="/adopt">Start Application</a>
          <a class="link-quiet" href="/available-pups">Browse all available pups</a>
        </aside>
      </div>
    </div>
  </section>

  {moreAnimals.length > 0 && (
    <section class="animal-more">
      <div class="container">
        <div class="animal-more__header">
          <div>
            <span class="eyebrow">More available pups</span>
            <h2>Keep Browsing</h2>
          </div>
          <a class="link-quiet" href="/available-pups">See all available pups</a>
        </div>
        <div class="animal-grid animal-grid--three">
          {moreAnimals.map((item) => <AnimalCard animal={item} />)}
        </div>
      </div>
    </section>
  )}
</MBPRLayout>
