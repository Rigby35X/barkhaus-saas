---
import MBPRLayout from "../../layouts/MBPRLayout.astro";
import AnimalCard from "../../components/mbpr/AnimalCard.astro";
import { getPublicAnimal, getPublicAnimals } from "../../lib/public-animals";

const animalKey = Astro.params.animalKey || "";
const animal = await getPublicAnimal(animalKey);

if (!animal) {
  return new Response("Animal not found", { status: 404 });
}

const allAnimals = await getPublicAnimals(Astro.locals);
const moreAnimals = allAnimals
  .filter((item) => item.animal_key && item.animal_key !== animal.animal_key)
  .slice(0, 4);

const photos = (animal.photos?.length ? animal.photos : [animal.primary_photo || animal.image_url]).filter(Boolean);
const primaryPhoto = photos[0] || "";
const extraPhotos = photos.slice(1, 3);
const formatDate = (value?: string) => {
  if (!value) return "";
  const parsed = new Date(value + (value.length === 10 ? "T12:00:00" : ""));
  return Number.isNaN(parsed.getTime())
    ? value
    : parsed.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
};
const birthday = formatDate(animal.birthday);
const title = `${animal.name} | Mission Bay Puppy Rescue`;
const description = animal.story
  ? animal.story.replace(/<[^>]*>/g, "").slice(0, 155)
  : `Meet ${animal.name}, currently available for adoption from Mission Bay Puppy Rescue.`;
---
<MBPRLayout title={title} description={description}>
  <section class="section tight">
    <div class="container">
      <a class="back-link" href="/available-pups">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
        Back to Available Pups
      </a>

      <div class="split" style="align-items:flex-start;">
        <div class="gallery">
          {primaryPhoto
            ? <div class="main-shot"><img src={primaryPhoto} alt={`${animal.name}, main adoption photo`} /></div>
            : <div class="main-shot pup-photo no-photo">Photo coming soon</div>}
          {extraPhotos.map((photo, index) => (
            <div class="sub-shot"><img src={photo} alt={`${animal.name}, additional photo ${index + 1}`} loading="lazy" /></div>
          ))}
        </div>

        <div>
          <span class="status-ribbon status-available" style="position:static; display:inline-flex; margin-bottom:14px;">{animal.status || "Available Now"}</span>
          <h1 style="margin-bottom:4px;">{animal.name}</h1>
          <p class="lede" style="margin-bottom:22px;">
            {animal.litter && <>Part of &ldquo;{animal.litter}&rdquo; {animal.breed && <>litter &middot; </>}</>}
            {animal.breed}
          </p>

          <div style="display:flex; flex-wrap:wrap; gap:14px; margin-bottom:26px;">
            <a class="btn btn-gold" href="/adopt">Apply to Adopt {animal.name}</a>
            <a class="btn btn-outline" href="/faq">Adoption FAQ</a>
          </div>

          <div class="quick-facts" style="margin-bottom:26px;">
            {animal.gender && <div class="fact"><div class="k">Sex</div><div class="v">{animal.gender}</div></div>}
            {animal.breed && <div class="fact"><div class="k">Breed / Mix</div><div class="v">{animal.breed}</div></div>}
            {animal.size && <div class="fact"><div class="k">Adult Size</div><div class="v">{animal.size}</div></div>}
            {birthday && <div class="fact"><div class="k">Birthday</div><div class="v">{birthday}</div></div>}
          </div>

          <h3>About {animal.name}</h3>
          {animal.story
            ? <div class="animal-story" style="white-space:pre-line;">{animal.story}</div>
            : <p style="opacity:.85;">More about {animal.name} is coming soon.</p>}

          {animal.litter && (
            <div style="margin-top:22px; padding:18px 20px; background:var(--sand-deep); border-radius:var(--radius-md); border:1px solid var(--sand-line);">
              <p style="margin:0; font-size:.92rem;"><strong>Looking for littermates?</strong> Browse all current pups from Mission Bay Puppy Rescue.</p>
              <a class="link-quiet" href="/available-pups" style="margin-top:8px; display:inline-block;">See All Available Pups &rarr;</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {moreAnimals.length > 0 && (
    <section class="section sand-deep">
      <div class="container">
        <span class="eyebrow">More Available Pups</span>
        <h2 style="margin-bottom:26px;">Keep Browsing</h2>
        <div class="grid grid-4">
          {moreAnimals.map((item) => <AnimalCard animal={item} />)}
        </div>
      </div>
    </section>
  )}
</MBPRLayout>