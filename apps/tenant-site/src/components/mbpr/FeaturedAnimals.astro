---
import AnimalCard from "./AnimalCard.astro";
import { getPublicAnimals } from "../../lib/public-animals";

const animals = await getPublicAnimals(Astro.locals);
---
<div class="featured-animal-scroller" aria-label="Available pups">
  {animals.map((animal) => (
    <div class="featured-animal-scroller__item">
      <AnimalCard animal={animal} statusPill={true} />
    </div>
  ))}
</div>
