---
const { animal } = Astro.props;
const image = animal.primary_photo || animal.image_url || animal.photos?.[0] || "";
const href = animal.animal_key ? `/available-pups/${animal.animal_key}` : "/adopt";
const meta = [animal.gender, animal.size].filter(Boolean);
---
<article class="animal-card">
  <a class="animal-card__link" href={href} aria-label={`Meet ${animal.name}`}>
    <div class="animal-card__media">
      {image
        ? <img src={image} alt={`${animal.name}, available for adoption`} loading="eager" decoding="async" />
        : <div class="animal-card__placeholder">Photo coming soon</div>}
    </div>

    <div class="animal-card__body">
      <div class="animal-card__heading">
        <h3>{animal.name}</h3>
        <span class="animal-card__arrow" aria-hidden="true">→</span>
      </div>
      <p class="animal-card__availability">{animal.status || "Available Now"}</p>

      {meta.length > 0 && <p class="animal-card__meta">{meta.join(" · ")}</p>}
      {animal.breed && <p class="animal-card__breed">{animal.breed}</p>}

      <span class="btn btn-navy btn-sm animal-card__button">Meet {animal.name}</span>
    </div>
  </a>
</article>
