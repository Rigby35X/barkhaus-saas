---
const { animal } = Astro.props;
const image = animal.primary_photo || animal.image_url || animal.photos?.[0] || "";
const href = animal.animal_key ? `/available-pups/${animal.animal_key}` : "/adopt";
---
<article class="pup-card">
  <a class="pup-photo" href={href} aria-label={`Meet ${animal.name}`}>
    <span class="status-ribbon status-available">{animal.status || "Available Now"}</span>
    {image
      ? <img src={image} alt={`${animal.name}, available for adoption`} loading="lazy" decoding="async" />
      : <div class="pup-photo no-photo">Photo coming soon</div>}
  </a>
  <div class="pup-body">
    <h3 class="pup-name">{animal.name}</h3>
    <div class="pup-facts">
      {animal.gender && <span>{animal.gender}</span>}
      {animal.size && <span>{animal.size}</span>}
      {(animal.age || animal.birthday) && <span>{animal.age || animal.birthday}</span>}
    </div>
    {animal.breed && <p class="text-small">{animal.breed}</p>}
    <a class="btn btn-navy btn-sm" href={href}>Meet {animal.name}</a>
  </div>
</article>