---
const { animal } = Astro.props;
const photos = (animal.photos?.length ? animal.photos : [animal.primary_photo || animal.image_url]).filter(Boolean);
const [primaryPhoto, ...secondaryPhotos] = photos;
---
<div class="animal-gallery" data-animal-gallery>
  {primaryPhoto ? (
    <figure class="animal-gallery__primary">
      <img
        src={primaryPhoto}
        alt={`${animal.name}, available for adoption`}
        fetchpriority="high"
        data-gallery-main
      />
    </figure>
  ) : (
    <div class="animal-gallery__primary animal-gallery__placeholder">Photo coming soon</div>
  )}

  {secondaryPhotos.length > 0 && (
    <div class="animal-gallery__rail-wrap">
      <button class="animal-gallery__rail-arrow animal-gallery__rail-arrow--prev" type="button" data-gallery-prev aria-label="Previous photos">←</button>
      <div class="animal-gallery__rail" data-gallery-rail aria-label={`More photos of ${animal.name}`}>
        {secondaryPhotos.map((photo, index) => (
          <button
            type="button"
            class="animal-gallery__thumb"
            data-gallery-thumb
            data-photo={photo}
            aria-label={`Show photo ${index + 2} of ${animal.name}`}
            aria-pressed="false"
          >
            <img src={photo} alt="" loading="eager" decoding="async" />
          </button>
        ))}
      </div>
      <button class="animal-gallery__rail-arrow animal-gallery__rail-arrow--next" type="button" data-gallery-next aria-label="More photos">→</button>
    </div>
  )}
</div>

<script>
  const initAnimalGalleries = () => {
    document.querySelectorAll("[data-animal-gallery]").forEach((gallery) => {
      if (gallery.dataset.galleryReady === "true") return;
      gallery.dataset.galleryReady = "true";

      const main = gallery.querySelector("[data-gallery-main]");
      const rail = gallery.querySelector("[data-gallery-rail]");
      const thumbs = [...gallery.querySelectorAll("[data-gallery-thumb]")];

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const photo = thumb.getAttribute("data-photo");
          if (!main || !photo) return;
          main.setAttribute("src", photo);
          thumbs.forEach((button) => {
            const active = button === thumb;
            button.classList.toggle("is-active", active);
            button.setAttribute("aria-pressed", active ? "true" : "false");
          });
        });
      });

      const scrollRail = (direction) => {
        if (!rail) return;
        rail.scrollBy({ left: direction * Math.max(rail.clientWidth * 0.72, 220), behavior: "smooth" });
      };

      gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => scrollRail(-1));
      gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => scrollRail(1));
    });
  };

  initAnimalGalleries();
  document.addEventListener("astro:page-load", initAnimalGalleries);
</script>
