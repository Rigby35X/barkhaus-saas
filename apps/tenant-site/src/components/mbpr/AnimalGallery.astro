---
const { animal } = Astro.props;
const photos = (animal.photos?.length ? animal.photos : [animal.primary_photo || animal.image_url]).filter(Boolean);
const primaryPhoto = photos[0];
---
<div class="animal-gallery" data-animal-gallery data-photos={JSON.stringify(photos)}>
  {primaryPhoto ? (
    <figure class="animal-gallery__primary">
      <img
        src={primaryPhoto}
        alt={`${animal.name}, available for adoption`}
        fetchpriority="high"
        data-gallery-main
      />
      {photos.length > 1 && (
        <>
          <button class="animal-gallery__main-arrow animal-gallery__main-arrow--prev" type="button" data-gallery-prev aria-label="Previous photo">←</button>
          <button class="animal-gallery__main-arrow animal-gallery__main-arrow--next" type="button" data-gallery-next aria-label="Next photo">→</button>
        </>
      )}
    </figure>
  ) : (
    <div class="animal-gallery__primary animal-gallery__placeholder">Photo coming soon</div>
  )}

  {photos.length > 1 && (
    <div class="animal-gallery__rail" data-gallery-rail aria-label={`Photos of ${animal.name}`}>
      {photos.map((photo, index) => (
        <button
          type="button"
          class:list={["animal-gallery__thumb", index === 0 && "is-active"]}
          data-gallery-thumb
          data-photo-index={index}
          aria-label={`Show photo ${index + 1} of ${animal.name}`}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <img src={photo} alt="" loading="eager" decoding="async" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  const initAnimalGalleries = () => {
    document.querySelectorAll("[data-animal-gallery]").forEach((gallery) => {
      if (gallery.dataset.galleryReady === "true") return;
      gallery.dataset.galleryReady = "true";

      const main = gallery.querySelector("[data-gallery-main]");
      const rail = gallery.querySelector("[data-gallery-rail]");
      const thumbs = [...gallery.querySelectorAll("[data-gallery-thumb]")];
      const photos = JSON.parse(gallery.getAttribute("data-photos") || "[]");
      let currentIndex = 0;
      let timer;

      const showPhoto = (index, userInitiated = false) => {
        if (!main || !photos.length) return;
        currentIndex = (index + photos.length) % photos.length;
        main.setAttribute("src", photos[currentIndex]);

        thumbs.forEach((button) => {
          const thumbIndex = Number(button.getAttribute("data-photo-index"));
          const active = thumbIndex === currentIndex;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
          if (active && userInitiated) {
            button.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
          }
        });
      };

      const restartAuto = () => {
        if (timer) window.clearInterval(timer);
        if (photos.length > 1) {
          timer = window.setInterval(() => showPhoto(currentIndex + 1), 6000);
        }
      };

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const index = Number(thumb.getAttribute("data-photo-index"));
          showPhoto(Number.isFinite(index) ? index : 0, true);
          restartAuto();
        });
      });

      gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => {
        showPhoto(currentIndex - 1, true);
        restartAuto();
      });

      gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => {
        showPhoto(currentIndex + 1, true);
        restartAuto();
      });

      gallery.addEventListener("mouseenter", () => {
        if (timer) window.clearInterval(timer);
      });
      gallery.addEventListener("mouseleave", restartAuto);

      if (rail) {
        rail.addEventListener("wheel", (event) => {
          if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
            rail.scrollLeft += event.deltaY;
            event.preventDefault();
          }
        }, { passive: false });
      }

      restartAuto();
    });
  };

  initAnimalGalleries();
  document.addEventListener("astro:page-load", initAnimalGalleries);
</script>
