---
import AnimalCard from "./AnimalCard.astro";
import { getPublicAnimals } from "../../lib/public-animals";

const animals = await getPublicAnimals(Astro.locals);
const groups = new Map();

for (const animal of animals) {
  const key = animal.litter || "Available Pups";
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(animal);
}
---
{animals.length === 0 ? (
  <div class="animal-empty">
    <span class="eyebrow">Checking in with the pack</span>
    <h2>Available pups are loading</h2>
    <p>Please check back shortly for our current adoptable dogs.</p>
  </div>
) : (
  <div class="animal-catalog">
    {Array.from(groups.entries()).map(([litter, items]) => (
      <section class="animal-group">
        <div class="animal-group__header">
          <div>
            <span class="eyebrow">Available now</span>
            <h2>{litter}</h2>
          </div>
          <span class="animal-group__count">{items.length} {items.length === 1 ? "pup" : "pups"}</span>
        </div>
        <div class="animal-grid">
          {items.map((animal) => <AnimalCard animal={animal} />)}
        </div>
      </section>
    ))}
  </div>
)}
