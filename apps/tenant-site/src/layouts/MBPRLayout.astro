---
import MBPRHeader from "../components/mbpr/MBPRHeader.astro";
import MBPRFooter from "../components/mbpr/MBPRFooter.astro";
import "../styles/mbpr-refresh.css";
const { title="Mission Bay Puppy Rescue", description="Mission Bay Puppy Rescue is a San Diego non-profit finding loving homes for rescue puppies and their mamas." }=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="icon" href="https://cdn.shopify.com/s/files/1/0752/2317/1383/files/MBPR_Logo_s-5.png?v=1728336857"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><MBPRHeader currentPath={Astro.url.pathname}/><main id="main"><slot/></main><MBPRFooter/><script is:inline src="/assets/mbpr-site.js"></script></body></html>